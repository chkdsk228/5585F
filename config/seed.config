# ============================================================
# 两个机型共用的 .config 种子
# 机型相关项(CONFIG_TARGET_DEVICE_* / CONFIG_TARGET_PROFILE)
# 由 scripts/prepare.sh 按 profile 追加
# ============================================================

# ---- 目标平台: airoha / an7581 (aarch64 cortex-a53) ----
CONFIG_TARGET_airoha=y
CONFIG_TARGET_airoha_an7581=y
CONFIG_TARGET_BOARD="airoha"
CONFIG_TARGET_SUBTARGET="an7581"
CONFIG_TARGET_ROOTFS_SQUASHFS=y

# ---- LuCI 基础 ----
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-compat=y
# luci-i18n-* 是 HIDDEN 包，单独写 =y 会被 make defconfig 清掉，
# 必须设置语言开关才会自动选中全部 luci-i18n-*-zh-cn 翻译包。
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y

# ---- 主题：Vantage（默认，唯一第三方主题）----
# anothaDev/luci-theme-vantage（monorepo），含主题本体 + 实况面板 luci-app-vantage
# 由 prepare 脚本 clone 到 package/ 后编译；实测支持 OpenWrt 25.12。
# 官方 bootstrap 主题作为 luci-base 默认依赖保留，不作显式选择。
CONFIG_PACKAGE_luci-theme-vantage=y
CONFIG_PACKAGE_luci-app-vantage=y

# ---- ONU 插件: naoki66/OpenWrt_ONU_CONFIG ----
CONFIG_PACKAGE_luci-app-onu=y
CONFIG_PACKAGE_luci-app-pon-status=y
CONFIG_PACKAGE_airoha-ponctl=y
CONFIG_PACKAGE_airoha-pond=y
CONFIG_PACKAGE_airoha-pon-debug=y

# ---- NPU: naoki66/luci-app-airoha ----
CONFIG_PACKAGE_luci-app-airoha-npu=y

# ---- 概览页 CPU 频率/温度：autocore 提供 RPC 授权 ----
# /sbin/cpuinfo、/sbin/tempinfo 由 config/overlay/sbin 注入到 rootfs，脚本本身正常；
# 但 LuCI 的 luci-mod-status-index ACL 只授权 getVersion/getUnixtime 等，
# getCPUInfo/getTempInfo 的授权声明在 autocore 的 luci-mod-status-autocore.json 里。
# 缺 autocore 时 ubus 调用被拒，状态页回退显示 board.system、温度行整行消失。
CONFIG_PACKAGE_autocore=y

# ---- 硬件加密引擎 EIP93 (AES/DES/authenc) ----
# an7581 的 config-6.18 默认未开 CONFIG_CRYPTO_DEV_EIP93；
# kmod-crypto-hw-eip93 的 DEPENDS 含 TARGET_airoha，选中后自动带入内核符号。
CONFIG_PACKAGE_kmod-crypto-hw-eip93=y
CONFIG_PACKAGE_kmod-cryptodev=y
CONFIG_PACKAGE_openssl-util=y
CONFIG_PACKAGE_libopenssl-devcrypto=y

# ---- USB 驱动群 ----
# 对齐上游，覆盖 USB 网卡 / 手机共享网络 / 蜂窝模组场景。
# HG5585F 有双 USB 口（usb0/usb1），这些驱动使能后可热插即用。
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-asix=y
CONFIG_PACKAGE_kmod-usb-net-asix-ax88179=y
CONFIG_PACKAGE_kmod-usb-net-cdc-eem=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-cdc-subset=y
CONFIG_PACKAGE_kmod-usb-net-huawei-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-ipheth=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-rtl8150=y
CONFIG_PACKAGE_kmod-usb-net-rtl8152=y
CONFIG_PACKAGE_kmod-usb-net-sierrawireless=y

# ---- CPU 调节 ----
CONFIG_PACKAGE_luci-app-cpufreq=y

# ---- 内核调优：BBR 拥塞控制 ----
# kmod-tcp-bbr 自带 AUTOLOAD 与 /etc/sysctl.d/12-tcp-bbr.conf，
# 装上即开机加载 tcp_bbr 并把默认拥塞控制切到 bbr。
# 高延迟链路吞吐明显优于 cubic。
CONFIG_PACKAGE_kmod-tcp-bbr=y

# ---- 编译加速：ccache ----
# 二次构建复用上次的目标文件；缓存目录由 prepare.sh 软链到仓库外的 cache/，
# 交给 GitHub Actions cache 跨构建保存。
CONFIG_CCACHE=y
